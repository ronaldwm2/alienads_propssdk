<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <!-- Base application theme. -->
    <style name="Theme.Calculator" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#48dbfb</item>
        <item name="colorPrimaryVariant">#0fb9b1</item>
        <item name="colorOnPrimary">#ffffff</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#26de81</item>
        <item name="colorSecondaryVariant">#20bf6b</item>
        <item name="colorOnSecondary">#ffffff</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        
        <!-- Customize action bar -->
        <item name="actionBarStyle">@style/CustomActionBar</item>
    </style>
    
    <style name="CustomActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">?attr/colorPrimary</item>
        <item name="titleTextStyle">@style/CustomActionBarTitle</item>
    </style>
    
    <style name="CustomActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">#ffffff</item>
        <item name="android:textSize">20sp</item>
    </style>
    
    <!-- Button styles -->
    <style name="NumberButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">#f1f2f6</item>
        <item name="android:textColor">#333333</item>
    </style>
    
    <style name="OperatorButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">#48dbfb</item>
        <item name="android:textColor">#ffffff</item>
    </style>
    
</resources>