<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <!-- Expression display showing the full calculation -->
    <TextView
        android:id="@+id/expressionDisplay"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text=""
        android:textSize="14sp"
        android:gravity="end|center_vertical"
        android:background="#e0e0e0"
        android:padding="8dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        android:fontFamily="monospace" />

    <!-- Main display showing current number or result -->
    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:text="0"
        android:textSize="36sp"
        android:gravity="end|center_vertical"
        android:background="#ffffff"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        android:fontFamily="monospace"
        android:textColor="#333333" />

    <!-- Button grid layout -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="6">

        <!-- Row 1: Functions and Clear -->
        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="2"
            android:layout_columnSpan="2"
            android:layout_margin="4dp"
            android:text="C"
            android:textSize="18sp"
            android:background="#ff6b6b"
            android:textColor="white" />

        <Button
            android:id="@+id/btnBackspace"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="⌫"
            android:textSize="18sp"
            android:background="#feca57"
            android:textColor="white" />

        <Button
            android:id="@+id/btnDivide"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="÷"
            android:textSize="18sp"
            android:background="#48dbfb"
            android:textColor="white" />

        <!-- Row 2: Numbers 7-9 and multiply -->
        <Button
            android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="7"
            android:textSize="18sp"
            android:background="#f1f2f6"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="8"
            android:textSize="18sp"
            android:background="#f1f2f6"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="9"
            android:textSize="18sp"
            android:background="#f1f2f6"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btnMultiply"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="×"
            android:textSize="18sp"
            android:background="#48dbfb"
            android:textColor="white" />

        <!-- Row 3: Numbers 4-6 and subtract -->
        <Button
            android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="4"
            android:textSize="18sp"
            android:background="#f1f2f6"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="5"
            android:textSize="18sp"
            android:background="#f1f2f6"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="6"
            android:textSize="18sp"
            android:background="#f1f2f6"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btnSubtract"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="-"
            android:textSize="18sp"
            android:background="#48dbfb"
            android:textColor="white" />

        <!-- Row 4: Numbers 1-3 and add -->
        <Button
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="1"
            android:textSize="18sp"
            android:background="#f1f2f6"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="2"
            android:textSize="18sp"
            android:background="#f1f2f6"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="3"
            android:textSize="18sp"
            android:background="#f1f2f6"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="+"
            android:textSize="18sp"
            android:background="#48dbfb"
            android:textColor="white" />

        <!-- Row 5: 0, decimal, and equals -->
        <Button
            android:id="@+id/btn0"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="2"
            android:layout_columnSpan="2"
            android:layout_margin="4dp"
            android:text="0"
            android:textSize="18sp"
            android:background="#f1f2f6"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btnDecimal"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="."
            android:textSize="18sp"
            android:background="#f1f2f6"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btnEquals"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="="
            android:textSize="18sp"
            android:background="#26de81"
            android:textColor="white" />

    </GridLayout>

    <!-- Instructions text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Double tap display to toggle theme • Swipe right for history • Long press C to clear all"
        android:textSize="10sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:textColor="#888888" />

</LinearLayout>